{
  "name": "okosdoboz-parcel-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "targets": {
    "default": {
      "context": "browser",
      "includeNodeModules": true,
      "isLibrary": false
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/server.mjs --preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "lucide": "^0.468.0",
    "mathjax": "^2.7.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "parcel": "^2.15.0"
  }
}
