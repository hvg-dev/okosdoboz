<stdClass>
    <texts>
        <hu>egy alagútba értem.</hu>
        <en />
    </texts>
    <texts>
        <hu>zakatol a gépem.</hu>
        <en />
    </texts>
    <texts>
        <hu>éppen netezek.</hu>
        <en />
    </texts>
    <texts>
        <hu>éppen fizetek.</hu>
        <en />
    </texts>
    <texts>
        <hu>a felhőket nézem éppen.</hu>
        <en />
    </texts>
    <texts>
        <hu>recsegett a székem.</hu>
        <en />
    </texts>
    <texts>
        <hu>már töltenem kéne.</hu>
        <en />
    </texts>
    <texts>
        <hu>alagútba értem.</hu>
        <en />
    </texts>
    <texts>
        <hu>metrózom éppen.</hu>
        <en />
    </texts>
    <texts>
        <hu>nem beszélek többé véled.</hu>
        <en />
    </texts>
    <texts>
        <hu>nem hallok semmit.</hu>
        <en />
    </texts>
    <texts>
        <hu>furcsán néznek rám a népek.</hu>
        <en />
    </texts>
    <texts>
        <hu>1. sor</hu>
        <en />
    </texts>
    <texts>
        <hu>2. sor</hu>
        <en />
    </texts>
    <texts>
        <hu>3. sor</hu>
        <en />
    </texts>
    <texts>
        <hu>4. sor</hu>
        <en />
    </texts>
    <texts>
        <hu>Lackfi János: Mobil etűdök</hu>
        <en />
    </texts>
    <texts>
        <hu>zörgött az egekben a gépek acélja.</hu>
        <en />
    </texts>
    <texts>
        <hu>még nem voltak számítógépek.</hu>
        <en />
    </texts>
    <texts>
        <hu>a pénz volt az ember célja.</hu>
        <en />
    </texts>
    <texts>
        <hu>még éle volt a szónak.</hu>
        <en />
    </texts>
    <texts>
        <hu>nem tudta az emberiség, mi a célja.</hu>
        <en />
    </texts>
    <texts>
        <hu>utcákon élt a koldus, a béna.</hu>
        <en />
    </texts>
    <texts>
        <hu>az ablakokon rácsok lettek.&lt;br /&gt;</hu>
        <en />
    </texts>
    <texts>
        <hu>összesúgtak egymás közt a népek.</hu>
        <en />
    </texts>
    <texts>
        <hu>beszéltek a falban a drótok, a lelkek.</hu>
        <en />
    </texts>
    <texts>
        <hu>az emberek örültek a kertnek.</hu>
        <en />
    </texts>
    <texts>
        <hu>vad, bábeli nyelvzavarok feleseltek.</hu>
        <en />
    </texts>
    <texts>
        <hu>a ködben lovacskák bandukoltak.</hu>
        <en />
    </texts>
    <texts>
        <hu>Kosztolányi Dezső: Litánia</hu>
        <en />
    </texts>
    <texts>
        <hu>falrament parlament.</hu>
        <en />
    </texts>
    <texts>
        <hu>szolgálj és ne láss bért.</hu>
        <en />
    </texts>
    <texts>
        <hu>adj pénzt és ne tudd mért.</hu>
        <en />
    </texts>
    <texts>
        <hu>papagájszerep és visszhang.</hu>
        <en />
    </texts>
    <texts>
        <hu>ház, hol rendületlenül.</hu>
        <en />
    </texts>
    <texts>
        <hu>ne szolgálj, ne adj vért.</hu>
        <en />
    </texts>
    <texts>
        <hu>ne csak papír légy, te Ház.</hu>
        <en />
    </texts>
    <texts>
        <hu>ennyi csak: játszótér.</hu>
        <en />
    </texts>
    <texts>
        <hu>halj meg más javáért.</hu>
        <en />
    </texts>
    <texts>
        <hu>szégyen, neve átok.</hu>
        <en />
    </texts>
    <texts>
        <hu>tompa, zsibbadt fájdalom.</hu>
        <en />
    </texts>
    <texts>
        <hu>viszály és pártharag.</hu>
        <en />
    </texts>
    <texts>
        <hu>Vörösmarty Mihály: Országháza</hu>
        <en />
    </texts>
    <texts>
        <hu>nagy kincs a király.</hu>
        <en />
    </texts>
    <texts>
        <hu>nincs demokrácia.</hu>
        <en />
    </texts>
    <texts>
        <hu>egyeneshátú a diplomácia.</hu>
        <en />
    </texts>
    <texts>
        <hu>napos az őszi délután.</hu>
        <en />
    </texts>
    <texts>
        <hu>az ember kövér vagy sovány.</hu>
        <en />
    </texts>
    <texts>
        <hu>az ajtó nyitva áll.</hu>
        <en />
    </texts>
    <texts>
        <hu>mindig telt a kincstár.</hu>
        <en />
    </texts>
    <texts>
        <hu>a tigris szelíd őz.</hu>
        <en />
    </texts>
    <texts>
        <hu>a legfőbb szolga a király.</hu>
        <en />
    </texts>
    <texts>
        <hu>ma még szabad a tánc.</hu>
        <en />
    </texts>
    <texts>
        <hu>illatos teából száll a gőz.</hu>
        <en />
    </texts>
    <texts>
        <hu>szabad a gondolat.</hu>
        <en />
    </texts>
    <texts>
        <hu>Dobai Bálint: Az én királyságomban</hu>
        <en />
    </texts>
    <texts>
        <hu>eltűnt, hamu lett.</hu>
        <en />
    </texts>
    <texts>
        <hu>elkallódott, akár egy amulett.</hu>
        <en />
    </texts>
    <texts>
        <hu>kicsomóz, becsomóz, vacakolgat.</hu>
        <en />
    </texts>
    <texts>
        <hu>vetett, s most arat.</hu>
        <en />
    </texts>
    <texts>
        <hu>rabszolga lett.</hu>
        <en />
    </texts>
    <texts>
        <hu>elrontója oly sok jónak.</hu>
        <en />
    </texts>
    <texts>
        <hu>kisgatyában füvet nyír, és pénzt &lt;br /&gt;keres.</hu>
        <en />
    </texts>
    <texts>
        <hu>akár egy mozgó képregény.</hu>
        <en />
    </texts>
    <texts>
        <hu>emlékekből él.</hu>
        <en />
    </texts>
    <texts>
        <hu>titokban verset ír, és érdekes.</hu>
        <en />
    </texts>
    <texts>
        <hu>fújtat téli éjszakán.</hu>
        <en />
    </texts>
    <texts>
        <hu>úszik minden délután.</hu>
        <en />
    </texts>
    <texts>
        <hu>Szentmártoni János: Befejezhetetlen vers önmagunk állásáról</hu>
        <en />
    </texts>
    <texts>
        <hu>kisgatyában füvet nyír, és pénzt keres.</hu>
        <en />
    </texts>
    <texts>
        <hu>fellobog majd ellohad.</hu>
        <en />
    </texts>
    <texts>
        <hu>nem konzervbarack.</hu>
        <en />
    </texts>
    <texts>
        <hu>nem zseblámpa.</hu>
        <en />
    </texts>
    <texts>
        <hu>szivarvég, mely el nem ég.</hu>
        <en />
    </texts>
    <texts>
        <hu>Tiszának virágja, régi emlék.</hu>
        <en />
    </texts>
    <texts>
        <hu>szépecskén halad.</hu>
        <en />
    </texts>
    <texts>
        <hu>dicsérd, néki dalt komponálj!</hu>
        <en />
    </texts>
    <texts>
        <hu>mint jó bort megbecsüld!</hu>
        <en />
    </texts>
    <texts>
        <hu>mint a szaunát, be kell melegítsd.</hu>
        <en />
    </texts>
    <texts>
        <hu>mint a cserepes virágot naponta öntöznöd kell.</hu>
        <en />
    </texts>
    <texts>
        <hu>mint a szép verset megjegyezd!</hu>
        <en />
    </texts>
    <texts>
        <hu>karba vedd, úgy védelmezd!</hu>
        <en />
    </texts>
    <texts>
        <hu>Szlukovényi Katalin: Hasonlatok a szerelemről</hu>
        <en />
    </texts>
</stdClass>